{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shuflo",
  "version": "0.1.0",
  "identifier": "com.rotyrotools.shuflo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' https://*.scdn.co https://*.spotifycdn.com"
    },
    "windows": [
      {
        "label": "main",
        "title": "Shuflo",
        "url": "main.html",
        "visible": false,
        "center": true,
        "resizable": false,
        "width": 420,
        "height": 600
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFNDM4QUU1MzM1Q0RCMzAKUldRdzIxd3o1WXBERHVZM1dpY1hZeW13dUplaDRuVHNCZ1d3aUNzMUhvT3NpZkl1ZWQ0Q1pQUFMK",
      "endpoints": [
        "https://github.com/rotyro-tools/shuflo/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "rotyro",
    "homepage": "https://github.com/rotyro-tools/shuflo",
    "shortDescription": "Truly random in-place shuffle for Spotify playlists",
    "longDescription": "Shuflo rewrites a Spotify playlist you own into a truly random order, so you can press play with Spotify's shuffle turned off and get a fair mix.",
    "category": "Utility",
    "copyright": "Copyright © 2026 rotyro",
    "license": "MIT",
    "licenseFile": "../LICENSE.md",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
